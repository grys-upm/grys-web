{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "_data/ods.yml",
  "description": "Objetivos de Desarrollo Sostenible de la página ODS.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "num",
      "color",
      "fg",
      "title",
      "desc"
    ],
    "additionalProperties": false,
    "properties": {
      "num": {
        "type": "integer",
        "minimum": 1,
        "maximum": 17
      },
      "principal": {
        "type": "boolean"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "fg": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "title": {
        "type": "object",
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false,
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "desc": {
        "type": "object",
        "required": [
          "es",
          "en"
        ],
        "additionalProperties": false,
        "properties": {
          "es": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "metas": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "num",
            "es",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "num": {
              "type": "string",
              "pattern": "^\\d{1,2}\\.[0-9a-z]{1,2}$"
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "proyectos": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    }
  }
}
