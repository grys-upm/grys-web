{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Convocatoria (_opportunities/*.md)",
  "description": "Deja de publicarse al pasar «deadline».",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})? [+-]\\d{4})?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "job",
        "scholarship",
        "student_project",
        "phd"
      ]
    },
    "title_es": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "line": {
      "type": "string",
      "enum": [
        "cps",
        "wsan",
        "iot",
        "sec",
        "nca",
        "rob",
        "dss",
        "mw",
        "sw",
        "edge",
        "smart"
      ]
    },
    "pdf": {
      "type": "string",
      "pattern": "^/assets/"
    },
    "contact": {
      "type": "string",
      "format": "email"
    },
    "lang": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "description": "Idioma en el que está escrito el texto"
    },
    "old_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "description": "URL de la web anterior que redirigen aquí"
    },
    "published": {
      "type": "boolean"
    }
  },
  "required": [
    "date",
    "deadline",
    "type",
    "lang"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "title_es"
      ]
    },
    {
      "required": [
        "title_en"
      ]
    }
  ]
}