{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "_data/repos.yml",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "owner"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "language": {
        "type": "string",
        "minLength": 1
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "desc_es": {
        "type": "string",
        "minLength": 1
      },
      "desc_en": {
        "type": "string",
        "minLength": 1
      },
      "projects": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "featured": {
        "type": "boolean"
      }
    }
  }
}