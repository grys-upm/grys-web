{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/",
        "http://localhost/en/",
        "http://localhost/grupo/equipo/",
        "http://localhost/investigacion/proyectos/",
        "http://localhost/investigacion/publicaciones/",
        "http://localhost/investigacion/proyectos/nextarc/",
        "http://localhost/actualidad/noticias/2026-04-24-estela-professional-association-awards/",
        "http://localhost/grupo/contacto/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["is-crawlable"],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse"
    }
  }
}
